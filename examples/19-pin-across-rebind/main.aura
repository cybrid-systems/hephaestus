; examples/19-pin-across-rebind/main.aura
;
; Phase 6 denseness — Axis C pin table across rebind + alloc pressure.
; Uses host (pin-stable-refs) / (unpin-stable-refs) on bare node-ids (#2189).
;
; Axes: A B C F · Escapes: 0
; Avoid free-var capture of locals into define helpers (H8).
;
; Run: ./scripts/run-aura.sh examples/19-pin-across-rebind/main.aura

(require "hephaestus-min" all:)

(heph:stats-reset!)

(display "=== Hephaestus 19-pin-across-rebind ===")
(newline)
(display "heph:min-version=")
(display heph:min-version)
(newline)

; Global vector — avoid free-capture of let* locals into load lambdas (H8).
(define heph19-vx (make-vector 256 0))
(heph:fill-index! heph19-vx 256 1)

(define installed
  (heph:install-source "(define kscale (lambda (x) (* x 2)))"))

(if (not installed)
  (begin
    (display "FAIL: install")
    (newline)
    (display "RESULT fail example=19-pin-across-rebind")
    (newline))
  (let* (; sum_i factor*(1+i) i=0..255 = factor * 256*257/2
         (closed2 65792)
         (closed3 98688)
         (c0 (heph:record-own! (heph:own-check)))
         (c0-ok (and (eq? (heph:alist-ref ":all-ok" c0 #f) #t)
                     (heph:check-eq (kscale 7) 14)))
         (pcount (heph:pin-nodes 0 1 2 3))
         (pin-ok (heph:pin-ok? pcount))
         (c1 (heph:record-own! (heph:own-check)))
         (c1-ok (and pin-ok (eq? (heph:alist-ref ":all-ok" c1 #f) #t)))
         (wave
           (let ((i 0) (acc 0))
             (while (lambda () (< i 600))
               (lambda ()
                 (let ((v (make-vector 48 i)))
                   (set! acc (+ acc (vector-ref v 0)))
                   (set! i (+ i 1)))))
             acc))
         (timed
           (heph:time-call
             (lambda ()
               (let ((k 0) (last 0))
                 (while (lambda () (< k 200))
                   (lambda ()
                     (let ((i 0) (acc 0))
                       (while (lambda () (< i 256))
                         (lambda ()
                           (set! acc (+ acc (kscale (vector-ref heph19-vx i))))
                           (set! i (+ i 1))))
                       (set! last acc)
                       (set! k (+ k 1)))))
                 last))
             51200))
         (load-ok
           (heph:check-eq (heph:alist-ref ":result" timed 0) closed2))
         (c2 (heph:record-own! (heph:own-check)))
         (c2-ok (and load-ok (eq? (heph:alist-ref ":all-ok" c2 #f) #t)))
         (r (heph:rebind-safe "kscale" "(lambda (x) (* x 3))" "pin-triple"))
         (r-ok (eq? (heph:alist-ref ":ok" r #f) #t))
         (post
           (heph:time-call
             (lambda ()
               (let ((k 0) (last 0))
                 (while (lambda () (< k 200))
                   (lambda ()
                     (let ((i 0) (acc 0))
                       (while (lambda () (< i 256))
                         (lambda ()
                           (set! acc (+ acc (kscale (vector-ref heph19-vx i))))
                           (set! i (+ i 1))))
                       (set! last acc)
                       (set! k (+ k 1)))))
                 last))
             51200))
         (post-ok
           (and r-ok
                (heph:check-eq (heph:alist-ref ":result" post 0) closed3)
                (heph:check-eq (kscale 7) 21)))
         (c3 (heph:record-own! (heph:own-check)))
         (c3-ok (and post-ok (eq? (heph:alist-ref ":all-ok" c3 #f) #t)))
         (snap (heph:snapshot "pin-golden"))
         (bad (heph:rebind-safe "kscale" "(lambda (x) (* x 99))" "pin-bad"))
         (poison (kscale 7))
         (restored (heph:restore snap))
         (after (kscale 7))
         (c4 (heph:record-own! (heph:own-check)))
         (c4-ok
           (and (eq? (heph:alist-ref ":ok" bad #f) #t)
                restored
                (= poison 693)
                (heph:check-eq after 21)
                (eq? (heph:alist-ref ":all-ok" c4 #f) #t)))
         (ucount (heph:unpin-nodes 0 1 2 3))
         (unpin-ok (and (number? ucount) (>= ucount 0)))
         (c5 (heph:record-own! (heph:own-check)))
         (c5-ok (and unpin-ok
                     (eq? (heph:alist-ref ":all-ok" c5 #f) #t)
                     (heph:check-eq (kscale 7) 21)))
         (all-ok
           (and c0-ok c1-ok c2-ok c3-ok c4-ok c5-ok
                (= (heph:escape-count) 0)
                (= (heph:stats-ref "correctness_fail") 0)
                (= (heph:stats-ref "ownership_fail") 0)
                (>= (heph:stats-ref "ownership_ok") 5))))
    (display "C0 own-ok=")
    (display c0-ok)
    (newline)
    (display "C1 pin-count=")
    (display pcount)
    (display " pin-ok=")
    (display pin-ok)
    (display " own-ok=")
    (display c1-ok)
    (newline)
    (display "C2 wave=")
    (display wave)
    (display " load: ")
    (write timed)
    (newline)
    (display "C2 load-ok=")
    (display load-ok)
    (display " own-ok=")
    (display c2-ok)
    (newline)
    (display "C3 rebind: ")
    (write r)
    (newline)
    (display "C3 post: ")
    (write post)
    (newline)
    (display "C3 r-ok=")
    (display r-ok)
    (display " post-ok=")
    (display post-ok)
    (display " own-ok=")
    (display c3-ok)
    (newline)
    (display "C4 poison=")
    (display poison)
    (display " restore=")
    (display restored)
    (display " after=")
    (display after)
    (display " ok=")
    (display c4-ok)
    (newline)
    (display "C5 unpin-count=")
    (display ucount)
    (display " own-ok=")
    (display c5-ok)
    (newline)
    (display "stats: ")
    (write (heph:stats-alist))
    (newline)
    (if all-ok
      (begin
        (display "PASS: pin-stable-refs across alloc+rebind+restore (escapes=0)")
        (newline)
        (display "RESULT pass example=19-pin-across-rebind escapes=0")
        (newline))
      (begin
        (display "FAIL: pin-across-rebind denseness")
        (newline)
        (display "RESULT fail example=19-pin-across-rebind")
        (newline)
        (display "  c0=")
        (display c0-ok)
        (display " c1=")
        (display c1-ok)
        (display " c2=")
        (display c2-ok)
        (display " c3=")
        (display c3-ok)
        (display " c4=")
        (display c4-ok)
        (display " c5=")
        (display c5-ok)
        (newline)))))
