; examples/17-ffi-hotpath-edge/main.aura
;
; Larger controlled performance escape denseness (axis E).
;   A — pure-Aura kscale load/rebind (evolvable core, E=0)
;   E — metered FFI abs on a hot edge loop (many escapes, isolated)
;
; Run: ./scripts/run-aura.sh examples/17-ffi-hotpath-edge/main.aura

(require "hephaestus-min" all:)

(heph:stats-reset!)

(display "=== Hephaestus 17-ffi-hotpath-edge ===")
(newline)

(define installed
  (heph:install-source "(define kscale (lambda (x) (* x 2)))"))

(if (not installed)
  (begin
    (display "FAIL: install")
    (newline)
    (display "RESULT fail example=17-ffi-hotpath-edge")
    (newline))
  (let* ((want2 (/ (* 2 (* 128 129)) 2))
         (want3 (/ (* 3 (* 128 129)) 2))
         (core-load
           (lambda ()
             (let ((i 1) (acc 0))
               (while (lambda () (<= i 128))
                 (lambda ()
                   (set! acc (+ acc (kscale i)))
                   (set! i (+ i 1))))
               acc)))
         (esc0 (heph:escape-count))
         (c0 (core-load))
         (c0-ok (and (= c0 want2) (= (heph:escape-count) esc0))))
    (display "C0 pure core load ok=")
    (display c0-ok)
    (display " sum=")
    (display c0)
    (display " escapes=")
    (display (heph:escape-count))
    (newline)

    (let* ((edge-n 500)
           (esc-before (heph:escape-count))
           (edge-ok #t)
           (edge-sum 0)
           (i 0))
      (while (lambda () (< i edge-n))
        (lambda ()
          (let* ((v (if (= (modulo i 2) 0) i (- 0 (+ i 1))))
                 (p (heph:pure-abs v))
                 (f (heph:ffi-abs v)))
            (if (not (= p f)) (set! edge-ok #f) #f)
            (set! edge-sum (+ edge-sum f))
            (set! i (+ i 1)))))
      (let* ((esc-after (heph:escape-count))
             (edge-delta (- esc-after esc-before))
             (edge-meter-ok (= edge-delta edge-n)))
        (display "E0 hot FFI edge ok=")
        (display edge-ok)
        (display " meter-ok=")
        (display edge-meter-ok)
        (display " delta=")
        (display edge-delta)
        (display " want=")
        (display edge-n)
        (display " sum=")
        (display edge-sum)
        (newline)

        (let* ((r (heph:rebind-safe "kscale" "(lambda (x) (* x 3))" "e-hot-triple"))
               (r-ok (eq? (heph:alist-ref ":ok" r #f) #t))
               (c1 (core-load))
               (c1-ok (and r-ok (= c1 want3) (= (kscale 7) 21)))
               (esc-mid (heph:escape-count))
               (core-no-new-e (= esc-mid esc-after)))
          (display "C1 rebind after hot E ok=")
          (display c1-ok)
          (display " no-new-E=")
          (display core-no-new-e)
          (display " sum=")
          (display c1)
          (newline)

          (let ((j 0))
            (while (lambda () (< j 100))
              (lambda ()
                (heph:ffi-abs (- 0 j))
                (set! j (+ j 1)))))
          (let* ((c2-ok (and (= (core-load) want3) (= (kscale 7) 21)))
                 (own (heph:record-own! (heph:own-check)))
                 (own-ok (eq? (heph:alist-ref ":all-ok" own #f) #t))
                 (total-e (heph:escape-count))
                 (all-ok
                   (and c0-ok edge-ok edge-meter-ok c1-ok core-no-new-e
                        c2-ok own-ok (>= total-e (+ edge-n 100)))))
            (display "C2 core after more E ok=")
            (display c2-ok)
            (display " own-ok=")
            (display own-ok)
            (display " total-escapes=")
            (display total-e)
            (newline)
            (display "stats: ")
            (write (heph:stats-alist))
            (newline)
            (if all-ok
              (begin
                (display "PASS: FFI hotpath edge metered; core denseness intact")
                (newline)
                (display "RESULT pass example=17-ffi-hotpath-edge core_E=0 edge_E=")
                (display total-e)
                (newline))
              (begin
                (display "FAIL: ffi-hotpath-edge denseness")
                (newline)
                (display "RESULT fail example=17-ffi-hotpath-edge")
                (newline)))))))))
