; examples/01-minimal-kernel/main.aura
;
; Phase 1 denseness probe — pure-Aura numerical kernels + baseline metrology.
; No mutation, no FFI. Escape count on hot path must be 0.
;
; Axes: A (kernel completeness) + F (metrology)
;
; Loop coverage:
;   Bind kernels → Run under load → Observe metrics → Verify correctness
;   (Mutation / rollback left to later probes)
;
; Run: ./scripts/run-aura.sh examples/01-minimal-kernel/main.aura
;
; Binding note: prefer let* over internal define for dependent values
; (host internal-define behaves like simultaneous letrec).

(require "hephaestus-min" all:)

(heph:stats-reset!)

(display "=== Hephaestus 01-minimal-kernel: pure-Aura denseness ===")
(newline)
(display "heph:min-version=")
(display heph:min-version)
(display " kernel-version=")
(display heph:kernel-version)
(newline)

; ── 1. sum-sq correctness (closed form) ──
(let* ((n-sq 5000)
       (got-sq (heph:sum-sq n-sq))
       (want-sq (heph:closed-sum-sq n-sq))
       (sq-ok (heph:check-eq got-sq want-sq)))
  (display "sum-sq n=")
  (display n-sq)
  (display " got=")
  (display got-sq)
  (display " want=")
  (display want-sq)
  (display " ok=")
  (display sq-ok)
  (newline)

  ; ── 2. sum-sq under load (metrology) ──
  (let* ((n-load 400000)
         (timed-sq
           (heph:time-call
             (lambda () (heph:sum-sq n-load))
             n-load))
         (load-sq (heph:alist-ref ":result" timed-sq 0))
         (load-ok (heph:check-eq load-sq (heph:closed-sum-sq n-load))))
    (display "load sum-sq: ")
    (write timed-sq)
    (newline)
    (display "load correctness ok=")
    (display load-ok)
    (newline)

    ; ── 3. dot product ──
    (let* ((N 2048)
           (reps 800)
           (va (make-vector N 0))
           (vb (make-vector N 0)))
      (heph:fill-index! va N 1)
      (heph:fill-index! vb N 2)
      (let* ((want-dot
               (let ((i 0) (acc 0))
                 (while (lambda () (< i N))
                   (lambda ()
                     (set! acc (+ acc (* (+ 1 i) (+ 2 i))))
                     (set! i (+ i 1))))
                 acc))
             (got-dot (heph:dot va vb N))
             (dot-ok (heph:check-eq got-dot want-dot)))
        (display "dot N=")
        (display N)
        (display " got=")
        (display got-dot)
        (display " want=")
        (display want-dot)
        (display " ok=")
        (display dot-ok)
        (newline)

        (let* ((timed-dot
                 (heph:time-call
                   (lambda ()
                     (let ((k 0) (last-dot 0))
                       (while (lambda () (< k reps))
                         (lambda ()
                           (set! last-dot (heph:dot va vb N))
                           (set! k (+ k 1))))
                       last-dot))
                   (* reps N)))
               (load-dot-ok
                 (heph:check-eq (heph:alist-ref ":result" timed-dot 0) want-dot)))
          (display "load dot: ")
          (write timed-dot)
          (newline)
          (display "load dot correctness ok=")
          (display load-dot-ok)
          (newline)

          ; ── 4. saxpy + reduce ──
          (let* ((M 1024)
                 (vx (make-vector M 0))
                 (vy (make-vector M 0)))
            (heph:fill-index! vx M 0)
            (heph:fill-index! vy M 10)
            ; y'[i] = 3*x[i] + y[i] = 3*i + (10+i) = 10 + 4*i
            ; sum = 10*M + 2*M*(M-1)
            (let* ((want-sum (+ (* 10 M) (* 2 (* M (- M 1))))))
              (heph:saxpy! 3 vx vy M)
              (let* ((sum-got (heph:reduce-sum vy M))
                     (saxpy-ok (heph:check-eq sum-got want-sum)))
                (display "saxpy+reduce sum=")
                (display sum-got)
                (display " want=")
                (display want-sum)
                (display " ok=")
                (display saxpy-ok)
                (newline)

                ; ── Verdict ──
                (display "stats: ")
                (write (heph:stats-alist))
                (newline)

                (let ((all-ok
                        (and sq-ok load-ok dot-ok load-dot-ok saxpy-ok
                             (= (heph:stats-ref "correctness_fail") 0)
                             (>= (heph:stats-ref "correctness_ok") 5)
                             (>= (heph:stats-ref "kernels_run") 2)
                             (= (heph:stats-ref "escapes") 0))))
                  (if all-ok
                    (begin
                      (display "PASS: pure-Aura kernels + metrology (escapes=0)")
                      (newline)
                      (display "RESULT pass example=01-minimal-kernel escapes=0")
                      (newline))
                    (begin
                      (display "FAIL: pure-Aura kernel denseness probe")
                      (newline)
                      (display "RESULT fail example=01-minimal-kernel")
                      (newline)
                      (display "  sq-ok=")
                      (display sq-ok)
                      (display " load-ok=")
                      (display load-ok)
                      (display " dot-ok=")
                      (display dot-ok)
                      (display " load-dot-ok=")
                      (display load-dot-ok)
                      (display " saxpy-ok=")
                      (display saxpy-ok)
                      (newline))))))))))))
