; examples/18-dense-kernels/main.aura
;
; Phase 6 denseness — broader pure-Aura numerical shapes (Axis A + B + F).
; Beyond BLAS-1 fragments: 1D Jacobi stencil, dense matmul, sparse gather.
; Evolvable core rebind of a scale factor under load; core E=0.
;
; Binding: prefer let* (H1 — internal define is simultaneous).
;
; Run: ./scripts/run-aura.sh examples/18-dense-kernels/main.aura

(require "hephaestus-min" all:)

(heph:stats-reset!)

(display "=== Hephaestus 18-dense-kernels ===")
(newline)
(display "heph:min-version=")
(display heph:min-version)
(display " kernel-version=")
(display heph:kernel-version)
(newline)

(define installed
  (heph:install-source "(define kscale (lambda (x) (* x 2)))"))

(if (not installed)
  (begin
    (display "FAIL: install")
    (newline)
    (display "RESULT fail example=18-dense-kernels")
    (newline))
  (let* ((n-jac 64)
         (in (make-vector n-jac 0))
         (out (make-vector n-jac 0))
         (_fill (heph:fill-index! in n-jac 0))
         (_jac (heph:jacobi1d! in out n-jac))
         (j-ends-ok
           (and (= (vector-ref out 0) 0)
                (= (vector-ref out (- n-jac 1)) (- n-jac 1))))
         (j-mid-ok
           (and (= (vector-ref out 1) 1)
                (= (vector-ref out 2) 2)
                (= (vector-ref out (quotient n-jac 2))
                   (quotient n-jac 2))))
         (a1-ok (and j-ends-ok j-mid-ok))
         ; Multi-step Jacobi: for in[i]=i, integer Jacobi is fixed point
         (jac-steps 40)
         (timed-j
           (heph:time-call
             (lambda ()
               (let ((s 0) (src in) (dst out))
                 (while (lambda () (< s jac-steps))
                   (lambda ()
                     (heph:jacobi1d! src dst n-jac)
                     (let ((t src))
                       (set! src dst)
                       (set! dst t))
                     (set! s (+ s 1))))
                 (heph:reduce-sum src n-jac)))
             (* jac-steps n-jac)))
         (j-sum (heph:alist-ref ":result" timed-j 0))
         (j-want (/ (* n-jac (- n-jac 1)) 2))
         (a1-load-ok
           (and (heph:check-eq j-sum j-want)
                (>= (heph:alist-ref ":elapsed_ms" timed-j -1) 0)))
         ; ── Matmul I * B = B ──
         (n-mm 8)
         (nn (* n-mm n-mm))
         (A (make-vector nn 0))
         (B (make-vector nn 0))
         (C (make-vector nn 0))
         (_id
           (let ((d 0))
             (while (lambda () (< d n-mm))
               (lambda ()
                 (vector-set! A (+ (* d n-mm) d) 1)
                 (set! d (+ d 1))))
             #t))
         (_bfill (heph:fill-index! B nn 1))
         (_mm (heph:matmul! A B C n-mm))
         (mm-ok
           (let ((k 0) (ok #t))
             (while (lambda () (< k nn))
               (lambda ()
                 (if (not (= (vector-ref C k) (vector-ref B k)))
                   (set! ok #f)
                   #f)
                 (set! k (+ k 1))))
             ok))
         (_mm-check (heph:check-eq (if mm-ok 1 0) 1))
         (timed-mm
           (heph:time-call
             (lambda ()
               (let ((r 0))
                 (while (lambda () (< r 20))
                   (lambda ()
                     (heph:matmul! A B C n-mm)
                     (set! r (+ r 1))))
                 (vector-ref C 0)))
             (* 20 (* n-mm (* n-mm n-mm)))))
         (a2-load-ok
           (and mm-ok
                (heph:check-eq (heph:alist-ref ":result" timed-mm 0)
                               (vector-ref B 0))))
         ; ── Sparse gather ──
         (vlen 256)
         (m-g 64)
         (v (make-vector vlen 0))
         (idx (make-vector m-g 0))
         (_vfill (heph:fill-index! v vlen 1))
         (_idx
           (let ((i 0))
             (while (lambda () (< i m-g))
               (lambda ()
                 (vector-set! idx i (modulo (* i 3) vlen))
                 (set! i (+ i 1))))
             #t))
         (g-got (heph:gather-sum v idx m-g))
         (g-want
           (let ((i 0) (acc 0))
             (while (lambda () (< i m-g))
               (lambda ()
                 (set! acc (+ acc (vector-ref v (vector-ref idx i))))
                 (set! i (+ i 1))))
             acc))
         (a3-ok (heph:check-eq g-got g-want))
         (pre
           (let ((i 0) (acc 0))
             (while (lambda () (< i m-g))
               (lambda ()
                 (set! acc (+ acc (kscale (vector-ref v (vector-ref idx i)))))
                 (set! i (+ i 1))))
             acc))
         (pre-ok (heph:check-eq pre (* 2 g-want)))
         (r (heph:rebind-safe "kscale" "(lambda (x) (* x 3))" "dense-triple"))
         (r-ok (eq? (heph:alist-ref ":ok" r #f) #t))
         (post
           (let ((i 0) (acc 0))
             (while (lambda () (< i m-g))
               (lambda ()
                 (set! acc (+ acc (kscale (vector-ref v (vector-ref idx i)))))
                 (set! i (+ i 1))))
             acc))
         (post-ok
           (and r-ok
                (heph:check-eq post (* 3 g-want))
                (heph:check-eq (kscale 7) 21)))
         (own (heph:record-own! (heph:own-check)))
         (own-ok (eq? (heph:alist-ref ":all-ok" own #f) #t)))
    (display "A1 jacobi ends-ok=")
    (display j-ends-ok)
    (display " mid-ok=")
    (display j-mid-ok)
    (newline)
    (display "A1 jacobi load: ")
    (write timed-j)
    (newline)
    (display "A1 load-ok=")
    (display a1-load-ok)
    (display " sum=")
    (display j-sum)
    (display " want=")
    (display j-want)
    (newline)
    (display "A2 matmul I*B=B ok=")
    (display mm-ok)
    (newline)
    (display "A2 matmul load: ")
    (write timed-mm)
    (newline)
    (display "A3 gather got=")
    (display g-got)
    (display " want=")
    (display g-want)
    (display " ok=")
    (display a3-ok)
    (newline)
    (display "B rebind: ")
    (write r)
    (newline)
    (display "B pre-ok=")
    (display pre-ok)
    (display " post-ok=")
    (display post-ok)
    (display " own-ok=")
    (display own-ok)
    (newline)
    (display "stats: ")
    (write (heph:stats-alist))
    (newline)
    (let ((all-ok
            (and a1-ok a1-load-ok a2-load-ok a3-ok pre-ok post-ok own-ok
                 (= (heph:escape-count) 0)
                 (= (heph:stats-ref "correctness_fail") 0)
                 (= (heph:stats-ref "ownership_fail") 0))))
      (if all-ok
        (begin
          (display "PASS: stencil+matmul+gather pure-Aura denseness (escapes=0)")
          (newline)
          (display "RESULT pass example=18-dense-kernels escapes=0")
          (newline))
        (begin
          (display "FAIL: dense-kernels denseness")
          (newline)
          (display "RESULT fail example=18-dense-kernels")
          (newline)
          (display "  a1=")
          (display a1-ok)
          (display " a1-load=")
          (display a1-load-ok)
          (display " a2=")
          (display a2-load-ok)
          (display " a3=")
          (display a3-ok)
          (display " post=")
          (display post-ok)
          (newline))))))
