; examples/16-long-n-100/main.aura
;
; Long soak N=100 pure-Aura rebind+load+own (axes A B C D F).
; Completes denseness soak ladder: 06 N=25 → 07 N=50 → 16 N=100.
;
; Run: ./scripts/run-aura.sh examples/16-long-n-100/main.aura

(require "hephaestus-min" all:)

(heph:stats-reset!)

(display "=== Hephaestus 16-long-n-100 ===")
(newline)

(define N-rounds 100)

(define installed
  (heph:install-source "(define kscale (lambda (x) (* x 2)))"))

(if (not installed)
  (begin
    (display "FAIL: install")
    (newline)
    (display "RESULT fail example=16-long-n-100")
    (newline))
  (begin
    ; Modest per-round load so N=100 stays CI-friendly with ms metrology.
    (define (run-load)
      (let ((k 0) (last 0))
        (while (lambda () (< k 40))
          (lambda ()
            (let ((i 1) (acc 0))
              (while (lambda () (<= i 64))
                (lambda ()
                  (set! acc (+ acc (kscale i)))
                  (set! i (+ i 1))))
              (set! last acc)
              (set! k (+ k 1)))))
        last))

    (define (closed factor)
      (/ (* factor (* 64 65)) 2))

    (define (body-for factor)
      (cond ((= factor 2) "(lambda (x) (* x 2))")
            ((= factor 3) "(lambda (x) (* x 3))")
            ((= factor 5) "(lambda (x) (* x 5))")
            (else "(lambda (x) (* x 2))")))

    (define (factor-for round)
      (let ((m (modulo round 3)))
        (cond ((= m 0) 2)
              ((= m 1) 3)
              (else 5))))

    (define round 0)
    (define fail-count 0)
    (define own-fail 0)
    (define rebind-fail 0)
    (define t0 (try (monotonic-ms) (catch (e) 0)))

    (while (lambda () (< round N-rounds))
      (lambda ()
        (let* ((fac (factor-for round))
               (r (heph:rebind-safe "kscale" (body-for fac) "soak100"))
               (r-ok (eq? (heph:alist-ref ":ok" r #f) #t))
               (sum (run-load))
               (want (closed fac))
               (sum-ok (and (number? sum) (number? want) (= sum want)))
               (sample-ok (= (kscale 7) (* fac 7)))
               (chk (heph:own-check))
               (own-ok (eq? (heph:alist-ref ":all-ok" chk #f) #t)))
          (if (not r-ok) (set! rebind-fail (+ rebind-fail 1)) #f)
          (if (not (and sum-ok sample-ok))
            (set! fail-count (+ fail-count 1))
            #f)
          (if (not own-ok)
            (set! own-fail (+ own-fail 1))
            #f)
          (set! round (+ round 1)))))

    (define t1 (try (monotonic-ms) (catch (e) 0)))
    (define elapsed
      (if (and (number? t0) (number? t1) (>= (- t1 t0) 0)) (- t1 t0) -1))

    (display "rounds=")
    (display N-rounds)
    (display " fail=")
    (display fail-count)
    (display " own-fail=")
    (display own-fail)
    (display " rebind-fail=")
    (display rebind-fail)
    (display " escapes=")
    (display (heph:escape-count))
    (display " elapsed_ms=")
    (display elapsed)
    (newline)
    (display "final own=")
    (write (heph:own-check))
    (newline)

    (define all-ok
      (and (= fail-count 0)
           (= own-fail 0)
           (= rebind-fail 0)
           (= (heph:escape-count) 0)
           (heph:own-ok?)))

    (if all-ok
      (begin
        (display "PASS: soak N=100 rebind+load+own (escapes=0)")
        (newline)
        (display "RESULT pass example=16-long-n-100 escapes=0 rounds=100")
        (newline))
      (begin
        (display "FAIL: soak N=100")
        (newline)
        (display "RESULT fail example=16-long-n-100")
        (newline)))))
