; lib/hephaestus-min.aura — Phase 1–6 facade (Axes A–F)
;
; (require "hephaestus-min" all:)

(export heph:stats heph:stats-reset! heph:stats-ref heph:stats-bump!
        heph:stats-set! heph:stats-alist heph:alist-ref
        heph:time-call heph:ops-per-sec heph:ops-per-ms
        heph:throughput-ratio heph:envelope-ok?
        heph:fill-index! heph:fill-const!
        heph:sum-sq heph:dot heph:saxpy! heph:reduce-sum
        heph:jacobi1d! heph:matmul! heph:gather-sum
        heph:kernel-version heph:min-version
        heph:closed-sum-sq heph:check-eq
        heph:install-source heph:safety-ok? heph:snapshot heph:restore
        heph:rebind-safe
        heph:alist-get heph:ownership-pass? heph:nodes-pass?
        heph:own-check heph:safety-alist heph:own-ok? heph:record-own!
        heph:pin-nodes heph:unpin-nodes heph:pin-ok?
        heph:escape-note! heph:escape-count heph:with-escape
        heph:ffi-abs heph:pure-abs heph:ffi-sqrt heph:escape-version)

(require "hephaestus-measure" all:)
(require "hephaestus-kernel" all:)
(require "hephaestus-mutate" all:)
(require "hephaestus-own" all:)
(require "hephaestus-escape" all:)

(define heph:min-version 8)

; Closed form: sum_{i=0}^{n-1} i^2 = (n-1)n(2n-1)/6
(define (heph:closed-sum-sq n)
  (if (<= n 0)
    0
    (let ((m (- n 1)))
      (/ (* m n (- (* 2 n) 1)) 6))))

(define (heph:check-eq actual expected)
  (if (and (number? actual) (number? expected) (= actual expected))
    (begin (heph:stats-bump! "correctness_ok") #t)
    (begin (heph:stats-bump! "correctness_fail") #f)))
