; lib/hephaestus-own.aura — Axis C: ownership / AST integrity helpers
;
; (require "hephaestus-own" all:)
;
; Surfaces used (all pure host / Aura — no foreign kernels):
;   (ast:validate-ownership)  → alist with :pass
;   (ast:validate-nodes)      → alist with :pass
;   (ast:validate-post-restore)
;   (mutate:safety-snapshot)  → boundary / quota signals
;   (pin-stable-refs) / (unpin-stable-refs) — Agent pin table (#2189)
;
; Phase 3: validate-ownership across rebind + alloc pressure.
; Phase 6: pin bare node-ids across rebind + alloc (probe 19).

(export heph:alist-get
        heph:ownership-pass?
        heph:nodes-pass?
        heph:own-check
        heph:safety-alist
        heph:own-ok?
        heph:record-own!
        heph:pin-nodes
        heph:unpin-nodes
        heph:pin-ok?)

(require "std/mutate" all:)
(require "hephaestus-measure" all:)

(define (heph:alist-get key lst default)
  (let loop ((ys lst))
    (cond ((null? ys) default)
          ((not (pair? (car ys))) (loop (cdr ys)))
          ((equal? (car (car ys)) key) (cdr (car ys)))
          (else (loop (cdr ys))))))

(define (heph:ownership-pass?)
  (try
    (let ((v (ast:validate-ownership)))
      (cond
        ((eq? v #t) #t)
        ((eq? v #f) #f)
        ((pair? v) (eq? (heph:alist-get ":pass" v #f) #t))
        (else #f)))
    (catch (e) #f)))

(define (heph:nodes-pass?)
  (try
    (let ((v (ast:validate-nodes)))
      (cond
        ((eq? v #t) #t)
        ((eq? v #f) #f)
        ((pair? v) (eq? (heph:alist-get ":pass" v #f) #t))
        (else #f)))
    (catch (e) #f)))

; Returns alist: :ownership :nodes :boundary :quota :all-ok
(define (heph:own-check)
  (let* ((o (heph:ownership-pass?))
         (n (heph:nodes-pass?))
         (safe (heph:safety-alist))
         (b (heph:alist-get ":boundary-safe?" safe #f))
         (q (heph:alist-get ":quota-ok?" safe #f))
         (all (and o n (eq? b #t) (eq? q #t))))
    (list (cons ":ownership" o)
          (cons ":nodes" n)
          (cons ":boundary-safe?" b)
          (cons ":quota-ok?" q)
          (cons ":all-ok" all))))

(define (heph:safety-alist)
  (try
    (mutate:safety-snapshot)
    (catch (e)
      (list (cons ":boundary-depth" -1)
            (cons ":boundary-safe?" #f)
            (cons ":quota-ok?" #f)))))

(define (heph:own-ok?)
  (eq? (heph:alist-get ":all-ok" (heph:own-check) #f) #t))

; Bump measure counters if present (optional keys via stats-set/bump).
(define (heph:record-own! check)
  (if (eq? (heph:alist-get ":all-ok" check #f) #t)
    (heph:stats-bump! "ownership_ok")
    (heph:stats-bump! "ownership_fail"))
  check)

; ── Pin table helpers (bare node-ids; host accepts int handles) ──
; Returns count of pins registered, or -1 on failure.
(define (heph:pin-nodes . ids)
  (try
    (let ((n (apply pin-stable-refs ids)))
      (if (number? n) n -1))
    (catch (e) -1)))

; Returns count unpinned, or -1 on failure. Host may return 0 if already gone.
(define (heph:unpin-nodes . ids)
  (try
    (let ((n (apply unpin-stable-refs ids)))
      (if (number? n) n -1))
    (catch (e) -1)))

(define (heph:pin-ok? pin-count)
  (and (number? pin-count) (>= pin-count 1)))
